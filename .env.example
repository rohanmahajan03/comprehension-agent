# Copy to .env before running docker compose:  cp .env.example .env

# Backend settings (read by pydantic-settings in backend/app/config.py)
DEBUG=false
CORS_ORIGINS=http://localhost:5173

# Claude API key, used by app/services/evaluator.py
LLM_API_KEY=

# Postgres connection string. Empty = InMemoryStore (no setup needed; this is what tests
# use). Set = PostgresStore. `docker compose up postgres` starts a local instance on
# port 5433 (not 5432, to avoid colliding with a locally-installed Postgres), published
# loopback-only (127.0.0.1:5433) so these fixed dev credentials aren't reachable from
# anyone else on the network — this value is for native/host use (uvicorn run directly,
# or `psql`); when the backend itself runs inside docker compose, DATABASE_URL is
# overridden in docker-compose.yml to reach the `postgres` service by name instead of
# localhost.
DATABASE_URL=postgresql+psycopg://comprehension_agent:devpassword@localhost:5433/comprehension_agent
