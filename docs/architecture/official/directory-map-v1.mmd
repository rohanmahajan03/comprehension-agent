graph TD
    Root["Project root<br/>(docker-compose*, .github/workflows, CLAUDE.md, README)"]
    Docs["docs/architecture<br/>versioned architecture diagrams (this system)"]

    subgraph "Backend (backend/)"
        Routers["app/routers<br/>HTTP endpoints — thin, no logic"]
        Services["app/services<br/>stubbed business logic (LLM seams)"]
        Models["app/models<br/>Pydantic schemas — source of truth"]
        Store["app/store<br/>storage abstraction + in-memory impl"]
        Tests["tests/<br/>pytest suite"]
    end

    subgraph "Frontend (frontend/src/)"
        Pages["pages/<br/>top-level views (upload, graph, study session)"]
        Components["components/<br/>reusable UI pieces"]
        Api["api/<br/>HTTP client wrapper"]
        Types["types/<br/>hand-kept schema mirror"]
    end

    Root -->|"build context"| Routers
    Root -->|"build context"| Pages
    Root -->|"CI runs"| Tests
    Root -->|"documented in"| Docs

    Routers -->|"calls"| Services
    Routers -->|"reads/writes"| Store
    Routers -->|"request/response shapes"| Models
    Services -->|"returns"| Models
    Store -->|"persists"| Models
    Tests -->|"exercises via TestClient"| Routers

    Pages -->|"fetches via"| Api
    Pages -->|"composes"| Components
    Api -->|"typed as"| Types
    Components -->|"typed as"| Types
    Models -.->|"hand-mirrored, kept in sync"| Types
